{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=codejudge;Username=postgres;Password=postgres"
  },
  "ApiKeySettings": {
    "Key": "dev-api-key-change-me"
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Evaluation": {
    "PollingIntervalSeconds": 2,
    "BatchSize": 5,
    "LockDurationSeconds": 90,
    "CompileTimeoutSeconds": 10,
    "RunTimeoutSeconds": 5,
    "MaxAttempts": 3
  },
  "Security": {
    "RestrictedKeywords": {
      "CSharp": [ "Process.Start", "System.IO", "System.Net", "System.Reflection", "unsafe", "DllImport" ],
      "Python": [ "os.system", "subprocess", "import os", "open(", "eval(", "exec(", "__import__" ],
      "JavaScript": [ "child_process", "require('fs')", "require('net')", "eval(", "process." ]
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
